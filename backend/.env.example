# Cole aqui a connection string que o Coolify gerou pro Postgres.
# Use o HOST INTERNO do servico (nome do container), nao localhost.
DATABASE_URL=postgres://usuario:senha@postgresql-xxxx:5432/schulezap

# Segredo pra assinar os tokens de login (gere um longo e aleatorio).
SECRET_KEY_BASE=troque-por-uma-chave-longa-e-aleatoria

# Dominios que podem chamar a API (o site do front). Separe por virgula.
CORS_ORIGINS=https://schulezap.com.br,https://www.schulezap.com.br

# Roda as seeds (dados demo) na primeira subida. Depois mude pra false.
RUN_SEEDS=true

RAILS_ENV=production
PORT=3000
